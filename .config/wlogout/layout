{
    "label" : "lock",
    "action" : "/usr/lib/kscreenlocker_greet --immediateLock",
    "keybind" : "l"
}
{
    "label" : "hibernate",
    "action" : "hyprshutdown --post-cmd 'systemctl hibernate'",
    "keybind" : "h"
}
{
    "label" : "shutdown",
    "action" : "hyprshutdown --post-cmd 'systemctl poweroff'",
    "keybind" : "s"
}
{
    "label" : "logout",
    "action" : "hyprshutdown",
    "keybind" : "e"
}
{
    "label" : "reboot",
    "action" : "hyprshutdown --post-cmd 'systemctl reboot",
    "keybind" : "r"
}
{
    "label" : "suspend",
    "action" : "/usr/lib/kscreenlocker_greet --immediateLock && systemctl suspend",
    "keybind" : "u"
}

